{
  "name": "cucaatendemais-workspace",
  "private": true,
  "scripts": {
    "test": "npm run test:worker && npm run test:portal",
    "lint": "npm run portal:lint",
    "typecheck": "npm run portal:typecheck",
    "build": "npm run portal:build",
    "test:worker": "python -m pytest worker/tests -q",
    "test:portal": "npm --prefix cuca-portal test",
    "test:edge": "cd supabase/functions/gerar-resumo-rede && deno test --allow-all && cd ../motor-agente && deno test --allow-all",
    "portal:lint": "npm --prefix cuca-portal run lint",
    "portal:typecheck": "npm --prefix cuca-portal run typecheck",
    "portal:build": "npm --prefix cuca-portal run build"
  }
}
